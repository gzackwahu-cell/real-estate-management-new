# Copy this file to .env.local and fill in the values from your Supabase project:
# Supabase Dashboard -> Project Settings -> API
#
# NEVER commit .env.local or any real key. Only this example file is tracked by Git.

# Public project URL. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Public anon/publishable key. Safe to expose ONLY because database access is
# restricted by Row Level Security (RLS) policies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only service role key. It bypasses RLS.
# NEVER prefix with NEXT_PUBLIC_ and NEVER import it in client-side code.
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket name for property photos and documents.
# Create this bucket in Supabase -> Storage before uploading files.
NEXT_PUBLIC_STORAGE_BUCKET=property-documents
