# Danwell environment template.
# Copy this file to .env.local and replace placeholders with environment-specific
# values. Never commit .env.local or any real credential.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser.

# ---------------------------------------------------------------------------
# REQUIRED IN ALL ENVIRONMENTS
# ---------------------------------------------------------------------------

# Supabase project URL from Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase anon/publishable key from Project Settings -> API.
# This key is public by design; Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Absolute public site URL, without a trailing slash.
# Used for metadataBase, canonical URLs, /sitemap.xml, /robots.txt and public
# sharing links. Local development falls back to http://localhost:3000 when unset.
# Deployed builds REQUIRE a non-empty absolute http(s) value; an empty or invalid
# value fails the build with an actionable error.
NEXT_PUBLIC_SITE_URL=https://YOUR_DEPLOYMENT_DOMAIN.example

# ---------------------------------------------------------------------------
# REQUIRED IN PRODUCTION AND HOSTED STAGING; OPTIONAL FOR LOCAL DEVELOPMENT
# ---------------------------------------------------------------------------

# Shared rate limiting for public enquiry and viewing forms.
# Create an Upstash Redis database and copy its REST URL and token from the
# Upstash console. Both are server-only secrets; never prefix with NEXT_PUBLIC_.
# Leave BOTH values blank locally to use the development-only in-memory fallback.
# A partial configuration, missing production configuration, or provider failure
# fails closed.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Platform-managed values read by the rate limiter: NODE_ENV and VERCEL_ENV.
# Next.js/Vercel set these automatically. Do not add them to .env.local.
